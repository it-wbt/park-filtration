# Set the final production HTTPS origin before deployment.
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.example
# Google Apps Script web-app URL that saves enquiries and emails the PARK team.
# NEXT_PUBLIC_GOOGLE_ENQUIRY_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
